#
# IMPORTANT:
# Use the exact `{WATI_API_ENDPOINT}` shown in your WATI Dashboard → API Docs.
# It is tenant-specific (not always https://api.wati.io).
#
WATI_API_ENDPOINT=https://YOUR-WATI-API-ENDPOINT
WATI_ACCESS_TOKEN=put-your-token-here

# Notes:
# - Do NOT include `/api/...` paths here; the app will append `/api/v1/...` automatically.

# Redis (required for session history – no in-memory bloat)
REDIS_URL=redis://localhost:6379/0

# Edyoda RAG (required if enabled)
EDYODA_RAG_ENABLED=true
# These can be provided either as environment variables OR here in `.env`.
OPENAI_API_KEY=put-your-openai-key-here
ANTHROPIC_API_KEY=put-your-anthropic-key-here
PINECONE_API_KEY=put-your-pinecone-key-here

# Admin token for the /admin/* routes (choose a long random string)
ADMIN_TOKEN=put-a-long-random-string-here

# LMS API base URL for the edyoda-lms MCP server
EDYODA_LMS_BASE_URL=put-your-lms-base-url-here

# Comma-separated WhatsApp numbers (with country code) alerted on deflected chats
DEFLECT_ALERT_NUMBERS=91XXXXXXXXXX,91YYYYYYYYYY
